{
    "name": "ultreyaonline/standalone",
    "type": "project",
    "description": "The Ultreya Community Application",
    "keywords": [
        "tres dias",
        "tresdias"
    ],
    "license": "MIT",
    "authors": [{"name": "Chris Brown"}],
    "require": {
        "php": "^8.1",
        "ext-redis": ">4.3",
        "bensampo/laravel-enum": "^6.0",
        "doctrine/dbal": "^3.0",
        "drewm/mailchimp-api": "^2.5",
        "eluceo/ical": "^0.16.0",
        "guzzlehttp/guzzle": "^7.10",
        "illuminatech/config": "^1.3",
        "intervention/image": "^2.5",
        "lab404/laravel-impersonate": "^1.7|^2.0",
        "laracasts/flash": "^3.2",
        "laravel/framework": "^10.0",
        "laravel/horizon": "^5.7",
        "laravel/slack-notification-channel": "^2.2",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/livewire": "^2.0",
        "spatie/laravel-activitylog": "^4.0",
        "spatie/laravel-backup": "^8.0",
        "spatie/laravel-ignition": "^2.0",
        "spatie/laravel-medialibrary": "^10.0",
        "spatie/laravel-newsletter": "^5.0",
        "spatie/laravel-permission": "^6.0",
        "stripe/stripe-php": "^7.50",
        "symfony/http-client": "^8.0",
        "symfony/mailgun-mailer": "^7.1"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.0|^4.0",
        "barryvdh/laravel-ide-helper": "^3.0",
        "brianium/paratest": "^6.1",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.0",
        "phpunit/phpunit": "^9.5|^10.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "check-security": [
            "vendor/bin/security-checker security:check"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:generate",
            "@php artisan horizon:publish --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
