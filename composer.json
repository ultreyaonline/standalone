{
    "name": "ultreyaonline/standalone",
    "type": "project",
    "description": "The Ultreya Community Application",
    "keywords": [
        "tres dias",
        "tresdias"
    ],
    "license": "MIT",
    "authors": [{"name": "Chris Brown"}],
    "require": {
        "php": "^8.4",
        "ext-redis": ">4.3",
        "ext-zip": "*",
        "bensampo/laravel-enum": "^6.0",
        "doctrine/dbal": "^3.0",
        "drewm/mailchimp-api": "^2.5",
        "eluceo/ical": "^0.16.0",
        "guzzlehttp/guzzle": "^7.10",
        "illuminatech/config": "^1.3",
        "intervention/image": "^2.5",
        "lab404/laravel-impersonate": "^1.7",
        "laracasts/flash": "^3.2",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.7",
        "laravel/slack-notification-channel": "^3.0",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/livewire": "^4.1",
        "spatie/laravel-activitylog": "^4.0",
        "spatie/laravel-backup": "^9.0",
        "spatie/laravel-ignition": "^2.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-newsletter": "^5.0",
        "spatie/laravel-permission": "^7.0",
        "stripe/stripe-php": "^7.50",
        "symfony/http-client": "^8.0",
        "symfony/mailgun-mailer": "^7.1|^8.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.0|^4.0",
        "barryvdh/laravel-ide-helper": "^3.0",
        "brianium/paratest": "^7.0",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^12.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:generate"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    }
}
